# ---------------------------------------------------------------
# Nexus Internet Scheduler - configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

NODE_ENV=production

# Dashboard. Keep 127.0.0.1 until login + firewall are verified.
HOST=127.0.0.1
PORT=3000
# Must be true to bind to anything other than localhost.
ALLOW_LAN=false

# PostgreSQL (dedicated database + role, see scripts/db-setup.sql)
DATABASE_URL=postgres://nexus_scheduler:CHANGE_ME@127.0.0.1:5432/nexus_scheduler

# Long random string (at least 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# NETGEAR C6230. SOAP service verified on port 5000.
ROUTER_ADAPTER=netgear
ROUTER_HOST=192.168.0.1
ROUTER_PORT=5000
ROUTER_USERNAME=admin
ROUTER_PASSWORD=
ROUTER_TIMEOUT_MS=10000
# How often to re-read the router's device list (minutes).
ROUTER_POLL_MINUTES=5

# Extra MAC addresses that must never be blocked (comma separated).
# This PC and the router are protected automatically.
PROTECTED_MACS=

APP_TIMEZONE=America/New_York

# Safety switches. Real router changes need BOTH:
#   DRY_RUN=false here, AND clicking "Arm" on the dashboard.
SCHEDULER_ENABLED=true
DRY_RUN=true

LOG_LEVEL=info
